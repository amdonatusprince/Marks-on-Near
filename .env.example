# Marks environment. One file for the app and the scripts.
#   cp .env.example .env
#   ln -sfn ../.env agent/.env
# Scripts source this file. The app reads it through that link.
# Keys stay in the near-cli keychain. Never commit .env.

# --- App ---
PORT=3000
PING_MESSAGE=pong

# Chain the desk and the agent read. Vite exposes VITE_* to the browser.
# The v2 scripts use these same three accounts. There is no second copy.
VITE_CONTRACT_ID=marks2-6e889d.testnet
VITE_ORACLE_ID=oracle2-6e889d.testnet
VITE_TOKEN_ID=musdc-6e889d.testnet
VITE_INTENTS_RECIPIENT=marks.near
VITE_TESTNET_RPC=https://test.rpc.fastnear.com
# VITE_MAINNET_CONTRACT_ID=

# Price keeper and, in the container, the relayer. The account is AGENT_ID
# unless MARKS_KEEPER_ACCOUNT is set. On a Mac the keychain signs, so leave
# the key empty. The container imports this ed25519 secret for near-cli on
# start. MARKS_KEEPER=off disables the loop. MARKS_KEEP_LEAD is seconds
# before a mark or share is restamped, 1800 by default.
# MARKS_KEEPER_ACCOUNT=
MARKS_KEEPER_KEY=

# Agent panel. Leave DATABASE_URL empty. Sign-in and chats live in
# agent/data/pglite, the same file as local dev. Keep that directory.
# pnpm dev invents BETTER_AUTH_SECRET and remembers it.
# pnpm start will not. Generate one once and leave it:
#   openssl rand -hex 32
# BETTER_AUTH_SECRET=

# --- v1 scripts (create-accounts.sh, deploy.sh, e2e.sh, the relayer) ---
CONTRACT_ID=marks-05a557.testnet
COLLATERAL_ID=usdc-05a557.testnet
TRADER_ID=trader-05a557.testnet
TAKER_ID=taker-05a557.testnet
AGENT_ID=agent-05a557.testnet
ORACLE_ID=price-oracle.testnet
SYMBOL=NEAR-PERP
CATEGORY=crypto
TICK_SIZE=1000000
INITIAL_MARGIN_BPS=1000
MAINTENANCE_MARGIN_BPS=500
MAX_FUNDING_BPS=50
FUNDING_INTERVAL_NS=10000000000
STALE_AFTER_NS=120000000000
INSURANCE=1000000

# --- v1 demo board (demo.sh). Not the live v2 desk. ---
DEMO_CONTRACT_ID=marks-ffaba5.testnet
DEMO_ORACLE_ID=oracle-ffaba5.testnet
DEMO_TICK_SIZE=10000
DEMO_STALE_AFTER_NS=3600000000000

# --- v2 traders. The contract, oracle and token are the VITE_* lines above. ---
V2_TRADERS=t1-6e889d.testnet,t2-6e889d.testnet,t3-6e889d.testnet,t4-6e889d.testnet,t5-6e889d.testnet,t6-6e889d.testnet
